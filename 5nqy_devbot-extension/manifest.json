        "core/provider-contract.js",
        "core/settings-core.js",
        "core/theme.js",
        "providers/glm.js",
        "core/main.js",
        "core/orchestrator-content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "overlay.css"
      ]
    },
    {
