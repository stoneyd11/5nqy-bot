{
  "manifest_version": 3,
  "name": "5nqy_devbot — AI Developer Assistant",
  "version": "2.1.1",
  "description": "5nqy_devbot Ultra AI multi-agent developer assistant with Roblox Studio automation and resilient provider routing.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chat.deepseek.com/*",
    "https://deepseek.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://www.kimi.com/*",
    "https://kimi.com/*",
    "https://www.kimi.ai/*",
    "https://kimi.ai/*",
    "https://chat.z.ai/*",
    "https://chat.qwen.ai/*",
    "https://arena.ai/*",
    "https://www.meta.ai/*",
    "https://meta.ai/*",
    "https://chat.mistral.ai/*",
    "https://grok.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://copilot.microsoft.com/*",
    "https://poe.com/*",
    "https://huggingface.co/chat/*",
    "https://openrouter.ai/*",
    "https://agent.minimax.io/*",
    "https://minimax.io/*",
    "http://127.0.0.1/*",
    "ws://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "settings.html",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "5nqy_devbot",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "MacCtrl+Shift+Y"
      },
      "description": "Toggle 5nqy_devbot panel"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "core/provider-registry.js",
        "core/provider-contract.js",
        "core/settings-core.js",
        "core/theme.js",
        "providers/deepseek.js",
        "core/main.js",
        "core/orchestrator-content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "overlay.css"
      ]
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "providers/chatgpt-cm.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "core/provider-registry.js",
        "core/provider-contract.js",
        "core/settings-core.js",
        "core/theme.js",
        "providers/claude.js",
        "core/main.js",
        "core/orchestrator-content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "overlay.css"
      ]
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "core/provider-registry.js",
        "core/provider-contract.js",
        "core/settings-core.js",
        "core/theme.js",
        "providers/chatgpt.js",
        "core/main.js",
        "core/orchestrator-content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "overlay.css"
      ]
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "core/provider-registry.js",
        "core/provider-contract.js",
        "core/settings-core.js",
        "core/theme.js",
        "providers/gemini.js",
        "core/main.js",
        "core/orchestrator-content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "overlay.css"
      ]
    },
    {
      "matches": [
