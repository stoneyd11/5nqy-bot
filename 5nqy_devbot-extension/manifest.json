      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "core/provider-registry.js",
        "core/provider-contract.js",
        "core/settings-core.js",
        "core/theme.js",
        "providers/meta.js",
        "core/main.js",
        "core/orchestrator-content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "overlay.css"
      ]
    },
    {
      "matches": [
